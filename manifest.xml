<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">

  <!-- Add-in Metadata -->
  <Id>bb2b3b1c-007b-4e82-b2b3-50eb078e5f06</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Enterprise Engineering Consultants</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Enterprise Signature Manager" />
  <Description DefaultValue="Automatically adds corporate branded compact email signatures to outgoing emails." />
  <IconUrl DefaultValue="https://img.icons8.com/color/64/briefcase.png" />
  <HighResolutionIconUrl DefaultValue="https://img.icons8.com/color/128/briefcase.png" />

  <!-- Minimum Requirements -->
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.10" />
    </Sets>
  </Requirements>

  <!-- Permissions -->
  <Permissions>ReadWriteItem</Permissions>

  <!-- Mail App Version Overrides (Event-based activation for signatures) -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <!-- Runtimes for background event activation -->
          <Runtimes>
            <Runtime resid="Autorun">
              <Override type="javascript" resid="runtimeJs" />
            </Runtime>
          </Runtimes>

          <!-- Desktop / Web Form Factor -->
          <DesktopFormFactor>
            <!-- Background Event Listeners for Compose -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="ItemCompose" FunctionName="onNewMessageComposeHandler" SendMode="PromptUser" />
              </LaunchEvents>
              <SourceLocation resid="Autorun" />
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://img.icons8.com/color/16/briefcase.png" />
          <bt:Image id="Icon.32x32" DefaultValue="https://img.icons8.com/color/32/briefcase.png" />
          <bt:Image id="Icon.80x80" DefaultValue="https://img.icons8.com/color/80/briefcase.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Autorun" DefaultValue="https://raw.githack.com/Subyyal/xmlsign/main/autorun.html" />
          <bt:Url id="runtimeJs" DefaultValue="https://raw.githack.com/Subyyal/xmlsign/main/signature.js" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Signature Portal" />
          <bt:String id="ButtonLabel" DefaultValue="Insert Signature" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="ButtonTooltip" DefaultValue="Applies your verified enterprise signature." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
